# Runs the Terraform module tests offline (mocked AWS provider — no credentials needed).
#   docker build -f Dockerfile.test -t nmis-etl-pipeline-tests .
#   docker run --rm nmis-etl-pipeline-tests
FROM hashicorp/terraform:1.9.6

WORKDIR /app/infra/modules/aws_appflow_pipeline

COPY infra/modules/aws_appflow_pipeline/ ./

RUN terraform init -backend=false -input=false

ENTRYPOINT ["terraform"]
CMD ["test"]
